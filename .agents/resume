#!/usr/bin/env bash
set -euo pipefail

export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:${PATH}"

echo "==> Checking Apex Exec orb toolchains"
rustc_version="$(rustc --version)"
node_version="$(node --version)"
uv_version="$(uv --version)"

[[ "${rustc_version}" == rustc\ 1.88.0\ * ]] || {
  echo "expected Rust 1.88.0, found ${rustc_version}" >&2
  exit 1
}
[[ "${node_version}" == "v22.13.0" ]] || {
  echo "expected Node.js v22.13.0, found ${node_version}" >&2
  exit 1
}
[[ "${uv_version}" == "uv 0.7.12" ]] || {
  echo "expected uv 0.7.12, found ${uv_version}" >&2
  exit 1
}

echo "==> Orb toolchains are ready"
